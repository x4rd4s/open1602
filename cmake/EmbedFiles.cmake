# o1602_embed_files(<target> <namespace> <file>...) - compiles files into <target> so the game
# finds them without an installation folder. The generated source defines, in <namespace>,
#   extern const EmbeddedFile kEmbeddedFiles[]; extern const std::size_t kEmbeddedFileCount;
# with each file's name without its extension and its bytes (o1602/core/embedded_file.hpp).
# Changing a file rebuilds the target.

set(_o1602_embed_script "${CMAKE_CURRENT_LIST_DIR}/EmbedFiles.cmake")

function(o1602_embed_files target namespace)
    # One generated source per call: a target may embed several sets of files.
    string(MAKE_C_IDENTIFIER "${namespace}" set_name)
    set(output "${CMAKE_CURRENT_BINARY_DIR}/${target}_${set_name}_embedded.cpp")
    add_custom_command(
        OUTPUT "${output}"
        COMMAND "${CMAKE_COMMAND}" "-DOUTPUT=${output}" "-DNAMESPACE=${namespace}" "-DFILES=${ARGN}"
                -P "${_o1602_embed_script}"
        DEPENDS ${ARGN} "${_o1602_embed_script}"
        COMMENT "Embedding ${target} files"
        VERBATIM)
    target_sources(${target} PRIVATE "${output}")
endfunction()

# Script mode: writes OUTPUT from FILES.
if(CMAKE_SCRIPT_MODE_FILE AND OUTPUT)
    set(code "// Generated by cmake/EmbedFiles.cmake - do not edit.\n#include \"o1602/core/embedded_file.hpp\"\n\n")
    string(APPEND code "namespace ${NAMESPACE} {\n\nnamespace {\n\n")
    set(entries "")
    set(index 0)
    foreach(file IN LISTS FILES)
        get_filename_component(name "${file}" NAME_WE)
        file(READ "${file}" hex HEX)
        string(LENGTH "${hex}" hex_length)
        math(EXPR size "${hex_length} / 2")
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        # Line breaks keep the generated file readable for compilers with line limits.
        string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n    " bytes "${bytes}")
        string(APPEND code "constexpr unsigned char kFile${index}[] = {\n    ${bytes}0x00};\n\n")
        string(APPEND entries "    {\"${name}\", kFile${index}, ${size}},\n")
        math(EXPR index "${index} + 1")
    endforeach()
    string(APPEND code "}  // namespace\n\nextern const ::o1602::core::EmbeddedFile kEmbeddedFiles[] = {\n${entries}    {}};\n")
    string(APPEND code "extern const std::size_t kEmbeddedFileCount = ${index};\n\n}  // namespace ${NAMESPACE}\n")
    file(WRITE "${OUTPUT}" "${code}")
endif()
